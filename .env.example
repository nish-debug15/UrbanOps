# UrbanOps Environment Configuration

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Connection String (Atlas or Local Fallback: mongodb://127.0.0.1:27017/urbanops)
MONGO_URI=mongodb://127.0.0.1:27017/urbanops

# CORS Allowed Origin (e.g. Next.js frontend)
CLIENT_ORIGIN=http://localhost:3000

# Set to 1 only when running behind a reverse proxy (Nginx, Render, Railway) so
# X-Forwarded-For is trusted for client IPs. Leave unset locally.
# TRUST_PROXY=1

# Max telemetry events per IP per minute
TELEMETRY_RATE_LIMIT=60

# Severity tuning (PRD 6.2) and dedup radius
SEVERITY_DUP_MULTIPLIER=5
SEVERITY_DECAY_PER_HOUR=0.5
DEDUP_RADIUS_METERS=100

# Optional: separate database for `npm test` (dropped after each run)
# MONGO_TEST_URI=mongodb://127.0.0.1:27017/urbanops_test

# --- Auth ---
# REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT=20

# --- Seed accounts (npm run seed). Dev defaults are used when unset. ---
# SEED_ADMIN_EMAIL=admin@urbanops.local
# SEED_ADMIN_PASSWORD=
# SEED_DISPATCHER_EMAIL=dispatcher@urbanops.local
# SEED_DISPATCHER_PASSWORD=

# --- Issues ---
# Reports per user per 10 minutes
REPORT_RATE_LIMIT=20
# How often stored severity scores are refreshed for decay (ms). Default 10 min.
SEVERITY_TICK_MS=600000
