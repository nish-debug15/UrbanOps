# URL of the UrbanOps Express API (no trailing slash, no /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional: dispatcher coverage area for live updates, minLng,minLat,maxLng,maxLat (default: Bengaluru)
# NEXT_PUBLIC_COVERAGE_BBOX=77.45,12.85,77.8,13.1

# Testing from a phone on the same Wi-Fi: set NEXT_PUBLIC_API_URL to http://<this PC's LAN IP>:<api port>,
# list that IP here, and add http://<LAN IP>:3000 to CLIENT_ORIGIN in the API's .env.
# ALLOWED_DEV_ORIGINS=192.168.0.5
